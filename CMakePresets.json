{
  "version": 6,
  "configurePresets": [
    {
      "name": "host-debug",
      "displayName": "Host debug build with GCC",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/host-debug",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_CXX_COMPILER": "g++"
      }
    },
    {
      "name": "host-analysis",
      "displayName": "Host debug build with clang-tidy and cppcheck",
      "inherits": "host-debug",
      "binaryDir": "${sourceDir}/build/host-analysis",
      "cacheVariables": {
        "FLIGHT_STATIC_ANALYSIS": "ON"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "host-debug",
      "configurePreset": "host-debug"
    },
    {
      "name": "host-analysis",
      "configurePreset": "host-analysis"
    }
  ],
  "testPresets": [
    {
      "name": "host-debug",
      "configurePreset": "host-debug",
      "output": {
        "outputOnFailure": true
      }
    }
  ],
  "workflowPresets": [
    {
      "name": "host-debug",
      "steps": [
        { "type": "configure", "name": "host-debug" },
        { "type": "build", "name": "host-debug" },
        { "type": "test", "name": "host-debug" }
      ]
    },
    {
      "name": "host-analysis",
      "steps": [
        { "type": "configure", "name": "host-analysis" },
        { "type": "build", "name": "host-analysis" }
      ]
    }
  ]
}

